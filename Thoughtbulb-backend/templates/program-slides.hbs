  {{!-- LEARNING PROGRAM: 2 slides (objectives + outcomes + illustration, then module flow + photos). Built from `prog` in generator.js --}}
  <div class="page" style="position: relative; overflow: hidden; background: linear-gradient(160deg, #FFFCF6, #F6F4FF); font-family: Nunito, sans-serif;">
    <div style="position: absolute; left: 0; top: 0; width: 10px; height: 100%; background: #5B4FCF; z-index: 3;"></div>
    <img src="https://api.bd.eskoops.com/assets/pngAssets/ttb-logo.png" style="position: absolute; top: 14px; left: 16px; width: 72px; z-index: 10;" alt="The Thought Bulb" />
    {{#if prog.image}}<div style="position: absolute; left: 640px; top: 0; right: 0; bottom: 0; overflow: hidden; border-radius: 28px 0 0 28px;"><img src="{{prog.image}}" style="width: 100%; height: 100%; object-fit: cover; object-position: center 40%;" alt="" /></div>{{/if}}
    {{> progLeft}}
    <div style="position: absolute; left: 262px; top: 0; width: {{#if prog.image}}360{{else}}760{{/if}}px; height: 100%; display: flex; flex-direction: column; justify-content: center; color: #002F59;">
      <div style="display: flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 800; letter-spacing: .12em; color: #5B4FCF;"><span style="background: #EEECFF; border-radius: 999px; padding: 4px 10px;">LEARNING PROGRAM</span>{{#if prog.hours}}{{prog.hours}} HRS · {{/if}}{{prog.n_modules}} MODULES</div>
      {{#if prog.title}}<div style="font-size: 30px; font-weight: 900; line-height: 1.15; margin-top: 12px;">{{prog.title}}</div>{{/if}}
      <div style="display: flex; align-items: center; gap: 8px; margin: 20px 0 8px; font-size: 12px; font-weight: 800; letter-spacing: .1em; color: #5B4FCF;"><span style="width: 4px; height: 16px; border-radius: 2px; background: #5B4FCF;"></span>OBJECTIVES</div>
      {{#if prog.objectives.length}}
        {{#each prog.objectives}}<div style="display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 20px; margin-bottom: 7px;"><span style="flex: 0 0 8px; height: 8px; margin-top: 6px; border-radius: 50%; background: #5B4FCF;"></span><span>{{{boldmd this}}}</span></div>{{/each}}
      {{else}}
        <div style="font-size: 14px; line-height: 20px;">{{data.game_objective}}</div>
      {{/if}}
      {{#if prog.outcomes.length}}
      <div style="display: flex; align-items: center; gap: 8px; margin: 16px 0 10px; font-size: 12px; font-weight: 800; letter-spacing: .1em; color: #5B4FCF;"><span style="width: 4px; height: 16px; border-radius: 2px; background: #5B4FCF;"></span>TRAINING OUTCOMES</div>
      <div style="background: #fff; border: 1px solid #E6E3F7; border-radius: 16px; padding: 4px 16px;">
        {{#each prog.outcomes}}<div style="display: flex; align-items: center; gap: 12px; padding: 8px 0;{{#unless @first}} border-top: 1px dashed #E6E3F7;{{/unless}}"><span style="flex: 0 0 24px; height: 24px; border-radius: 50%; background: #EEECFF; display: flex; align-items: center; justify-content: center;"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 6.4l2.6 2.4L10 3.2" stroke="#5B4FCF" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span style="font-size: 15px; font-weight: 800;">{{this}}</span></div>{{/each}}
      </div>
      {{/if}}
    </div>
  </div>

  <div class="page" style="position: relative; overflow: hidden; background: linear-gradient(160deg, #F5F9FF, #FFF7F0); font-family: Nunito, sans-serif;">
    <div style="position: absolute; left: 0; top: 0; width: 10px; height: 100%; background: #5B4FCF; z-index: 3;"></div>
    <img src="https://api.bd.eskoops.com/assets/pngAssets/ttb-logo.png" style="position: absolute; top: 14px; left: 16px; width: 72px; z-index: 10;" alt="The Thought Bulb" />
    {{> progLeft}}
    <div style="position: absolute; left: 262px; right: 34px; top: 0; height: 100%; display: flex; flex-direction: column; justify-content: center; color: #002F59;">
      <div style="display: flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 800; letter-spacing: .12em; color: #5B4FCF;"><span style="background: #EEECFF; border-radius: 999px; padding: 4px 10px;">LEARNING PROGRAM</span>{{upper data.game_name}}</div>
      <div style="font-size: 28px; font-weight: 900; margin-top: 8px;">Program flow</div>
      <div style="font-size: 14px; font-weight: 700; color: #4a5b70;">{{prog.n_modules}} modules{{#if prog.hours}} · {{prog.hours}} hours of hands-on learning{{/if}}{{#if prog.post}} · ends with a personal action plan{{/if}}</div>
      <div style="display: flex; align-items: stretch; margin-top: 12px;">
        {{#each prog.modules}}
        {{#unless @first}}<div style="flex: 0 0 18px; display: flex; align-items: center; justify-content: center; color: #B9B3EE; font-size: 20px; font-weight: 900;">›</div>{{/unless}}
        <div style="flex: 1; min-width: 0; background: #fff linear-gradient({{c}}, {{c}}) top / 100% 5px no-repeat; border: 1px solid #E3E8EF; border-radius: 16px; padding: 14px 14px 12px; display: flex; flex-direction: column;">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="width: 26px; height: 26px; border-radius: 50%; background: {{c}}; color: #fff; font-size: 13px; font-weight: 900; display: flex; align-items: center; justify-content: center;">{{n}}</span>
            {{#if mins}}<span style="font-size: 11.5px; font-weight: 800; color: #4a5b70; background: #F1F3F7; border-radius: 999px; padding: 3px 10px; white-space: nowrap;">{{mins}} mins</span>{{/if}}
          </div>
          <div style="font-size: 18px; font-weight: 900; line-height: 1.15; margin: 8px 0; min-height: 40px;">{{name}}</div>
          {{#if how}}
          <div style="border-top: 1px dashed #E3E8EF; padding-top: 7px; font-size: 10.5px; font-weight: 800; letter-spacing: .12em; color: #8a96a8;">HOW</div>
          <div style="font-size: 12.5px; line-height: 17px; color: #33475f; font-weight: 600; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: {{#if ../prog.photos.length}}6{{else}}11{{/if}}; -webkit-box-orient: vertical; overflow: hidden;">{{{boldmd how}}}</div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{#if prog.photos.length}}
      <div style="display: flex; gap: 10px; margin-top: 10px; height: 118px;">
        {{#each prog.photos}}<div style="flex: 1; overflow: hidden; border-radius: 14px;"><img src="{{this}}" style="width: 100%; height: 100%; object-fit: cover; display: block;" alt="" /></div>{{/each}}
      </div>
      {{/if}}
      {{#if prog.post}}
      <div style="display: flex; align-items: center; gap: 14px; margin-top: 10px; background: #002F59; border-radius: 16px; padding: 9px 18px; color: #fff;">
        <span style="flex: 0 0 34px; height: 34px; border-radius: 50%; background: #FFB766; display: flex; align-items: center; justify-content: center;"><svg width="18" height="18" viewBox="0 0 18 18"><circle cx="9" cy="9" r="7" stroke="#002F59" stroke-width="2" fill="none"/><circle cx="9" cy="9" r="3" fill="#002F59"/></svg></span>
        <div><div style="font-size: 11px; font-weight: 800; letter-spacing: .12em; color: #FFB766;">POST PROGRAM</div><div style="font-size: 16px; font-weight: 900;">{{prog.post}}</div></div>
      </div>
      {{/if}}
    </div>
  </div>
